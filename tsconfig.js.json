{
  // The plain JS, checked against its JSDoc and the libraries' types. Not
  // strict: an untyped parameter is unchecked, as in JS.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["scripts/*.mjs", "demo/*.mjs"],
  // esbuild output (demo/build.mjs), not ours.
  "exclude": ["demo/wasi-worker-browser.mjs"]
}

{
  "name": "resvg-napi",
  "version": "0.1.0",
  "description": "Node bindings for resvg, generated from the upstream Rust sources: SVG to PNG, the usvg tree, fonts and text measurement.",
  "keywords": [
    "svg",
    "png",
    "render",
    "rasterize",
    "resvg",
    "usvg",
    "tiny-skia",
    "napi-rs",
    "wasm",
    "text-measurement",
    "fontdb"
  ],
  "main": "index.js",
  "scripts": {
    "build": "napi build --platform --release",
    "test": "npm run test:node && npm run test:examples",
    "test:wasi": "NAPI_RS_NATIVE_LIBRARY_PATH=./resvg-napi.wasi.cjs npm run test:node",
    "test:node": "node --test",
    "test:examples": "node demo/render.mjs examples/roster.svg && node demo/render.mjs examples/badge-sheet.svg && node demo/render.mjs examples/photo-card.svg && node demo/render.mjs examples/sheet.svg --lang fr",
    "typecheck": "tsc",
    "build:debug": "napi build --platform",
    "artifacts": "napi artifacts",
    "create-npm-dirs": "napi create-npm-dirs",
    "prepublishOnly": "napi pre-publish -t npm",
    "version": "napi version",
    "demo": "napi build --platform --release --target wasm32-wasip1-threads && cp resvg-napi.wasm32-wasi.wasm demo/ && esbuild resvg-napi.wasi-browser.js --bundle --format=esm --outfile=demo/resvg.js && esbuild wasi-worker-browser.mjs --bundle --format=esm --outfile=demo/wasi-worker-browser.mjs && esbuild demo/liquid-entry.mjs --bundle --format=esm --outfile=demo/liquid.js && node demo/serve.mjs",
    "check:pins": "node scripts/check-pins.mjs",
    "check:pins:selftest": "node scripts/check-pins.mjs --selftest",
    "check:package": "node scripts/check-package.mjs",
    "check:package:selftest": "node scripts/check-package.mjs --selftest"
  },
  "types": "index.d.ts",
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@napi-rs/cli": "^3.8.6",
    "@types/node": "^26.2.0",
    "emnapi": "1.11.2",
    "esbuild": "^0.25.12",
    "liquidjs": "^10.29.0",
    "qrcode-generator": "^2.0.4",
    "typescript": "^6.0.3"
  },
  "napi": {
    "binaryName": "resvg-napi",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "wasm32-wasip1-threads"
    ]
  },
  "files": [
    "index.js",
    "index.d.ts",
    "browser.js",
    "README.md",
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "resvg-napi.wasi.cjs",
    "resvg-napi.wasi.d.cts",
    "resvg-napi.wasi-browser.js",
    "wasi-worker.mjs",
    "wasi-worker-browser.mjs",
    "fit.mjs"
  ],
  "engines": {
    "node": ">= 18"
  },
  "license": "Apache-2.0 OR MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p8nut/resvg-napi.git"
  },
  "optionalDependencies": {
    "resvg-napi-darwin-arm64": "0.1.0",
    "resvg-napi-darwin-x64": "0.1.0",
    "resvg-napi-linux-arm64-gnu": "0.1.0",
    "resvg-napi-linux-arm64-musl": "0.1.0",
    "resvg-napi-linux-x64-gnu": "0.1.0",
    "resvg-napi-linux-x64-musl": "0.1.0",
    "resvg-napi-wasm32-wasi": "0.1.0",
    "resvg-napi-win32-arm64-msvc": "0.1.0",
    "resvg-napi-win32-x64-msvc": "0.1.0"
  },
  "dependencies": {
    "@emnapi/runtime": "1.11.2",
    "@napi-rs/wasm-runtime": "1.2.3"
  },
  "browser": "browser.js",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

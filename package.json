{
  "name": "resvg-napi",
  "version": "0.11.0",
  "description": "Render SVG to PNG in Node — and read back the resolved tree, text metrics and fonts. Powered by resvg.",
  "keywords": [
    "svg",
    "png",
    "render",
    "rasterize",
    "resvg",
    "usvg",
    "tiny-skia",
    "napi-rs",
    "wasm",
    "text-measurement",
    "fontdb"
  ],
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "browser": "./browser.js",
      "default": "./index.js"
    },
    "./helpers": {
      "browser": {
        "types": "./helpers.browser.d.mts",
        "default": "./helpers.browser.mjs"
      },
      "types": "./helpers.d.mts",
      "default": "./helpers.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "napi build --platform --release",
    "test": "npm run test:node && npm run test:examples",
    "test:wasi": "NAPI_RS_NATIVE_LIBRARY_PATH=./resvg-napi.wasi.cjs npm run test:node",
    "test:node": "node --test",
    "test:examples": "node demo/render.mjs examples/roster.svg --strict && node demo/render.mjs examples/badge-sheet.svg --strict && node demo/render.mjs examples/photo-card.svg --strict && node demo/render.mjs examples/sheet.svg --lang fr --strict",
    "typecheck": "tsc",
    "create-npm-dirs": "napi create-npm-dirs",
    "version": "napi version",
    "demo": "npm run demo:build && node demo/serve.mjs",
    "demo:build": "npm run demo:wasm && node demo/build.mjs",
    "demo:wasm": "napi build --platform --release --target wasm32-wasip1-threads",
    "check:package": "node scripts/check-package.mjs",
    "report": "node scripts/codegen-report.mjs",
    "conformance": "node scripts/conformance.mjs",
    "conformance:fetch": "node scripts/conformance-fetch.mjs",
    "licenses": "node scripts/licenses.mjs"
  },
  "types": "index.d.ts",
  "devDependencies": {
    "@napi-rs/cli": "^3.10.12",
    "@types/node": "^26.6.6",
    "emnapi": "2.0.0-beta.3",
    "esbuild": "^0.28.2",
    "liquidjs": "^10.30.1",
    "pngjs": "^7.0.0",
    "qrcode-generator": "^2.0.4",
    "typescript": "^7.0.2"
  },
  "napi": {
    "binaryName": "resvg-napi",
    "dtsHeaderFile": "dts-header.d.ts",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "armv7-unknown-linux-gnueabihf",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "i686-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "aarch64-linux-android",
      "armv7-linux-androideabi",
      "wasm32-wasip1-threads"
    ],
    "constEnum": false
  },
  "files": [
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "THIRD-PARTY-NOTICES.md",
    "README.md",
    "browser.js",
    "helpers.browser.d.mts",
    "helpers.browser.mjs",
    "helpers.d.mts",
    "helpers.mjs",
    "index.d.ts",
    "index.js",
    "resvg-napi.wasi-browser.js",
    "resvg-napi.wasi.cjs",
    "resvg-napi.wasi.d.cts",
    "wasi-worker-browser.mjs",
    "wasi-worker.mjs"
  ],
  "engines": {
    "node": ">= 20.3"
  },
  "license": "Apache-2.0 OR MIT",
  "author": "p8nut <38731495+p8nut@users.noreply.github.com>",
  "homepage": "https://github.com/p8nut/resvg-napi#readme",
  "bugs": {
    "url": "https://github.com/p8nut/resvg-napi/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p8nut/resvg-napi.git"
  },
  "optionalDependencies": {
    "resvg-napi-android-arm-eabi": "0.11.0",
    "resvg-napi-android-arm64": "0.11.0",
    "resvg-napi-darwin-arm64": "0.11.0",
    "resvg-napi-darwin-x64": "0.11.0",
    "resvg-napi-linux-arm-gnueabihf": "0.11.0",
    "resvg-napi-linux-arm64-gnu": "0.11.0",
    "resvg-napi-linux-arm64-musl": "0.11.0",
    "resvg-napi-linux-x64-gnu": "0.11.0",
    "resvg-napi-linux-x64-musl": "0.11.0",
    "resvg-napi-wasm32-wasi": "0.11.0",
    "resvg-napi-win32-arm64-msvc": "0.11.0",
    "resvg-napi-win32-ia32-msvc": "0.11.0",
    "resvg-napi-win32-x64-msvc": "0.11.0"
  },
  "dependencies": {
    "@emnapi/core": "2.0.0-beta.3",
    "@emnapi/runtime": "2.0.0-beta.3",
    "@napi-rs/wasm-runtime": "1.2.7"
  },
  "browser": "browser.js",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "resvg-napi-wasm32-wasi": "0.11.0"
  },
  "peerDependenciesMeta": {
    "resvg-napi-wasm32-wasi": {
      "optional": true
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
